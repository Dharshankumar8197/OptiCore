# ==============================================================================
# OptiCore AI Backend — Environment Configuration
# ==============================================================================

# Server Network
HOST=0.0.0.0
PORT=8000
API_PORT=8000

# YOLO26s AI Inference Model
MODEL_PATH=./models/best.pt
CONFIDENCE_THRESHOLD=0.50
IOU_THRESHOLD=0.45
IMAGE_SIZE=640

# Ngrok Public HTTPS Tunnel (Required for Vercel / Remote Phone Access)
# Example URL: https://escapade-feast-outdated.ngrok-free.dev
# Command to run: ngrok http 8000 --url https://escapade-feast-outdated.ngrok-free.dev
NGROK_AUTHTOKEN=
NGROK_ENABLED=true


# Optional Groq LLaMA 3.3 Scene Explainer (Optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# CORS & Vercel Web App Compatibility
# Wildcard '*' or 'https://*.vercel.app' allows your Vercel deployment to connect
CORS_ALLOWED_ORIGINS=*

# Security
AUTH_REQUIRED=false
JWT_SECRET_KEY=change-this-jwt-secret-in-production-opticore
LOG_LEVEL=info

# Database
DATABASE_URL=sqlite:///./data/opticore.db
