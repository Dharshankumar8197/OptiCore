# ==============================================================================
# OptiCore Portable AI Server — Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the server.
# The Windows launchers (install.bat, start.bat) will automatically generate
# .env from this template if .env does not already exist.
# ==============================================================================

# ── Container Image Reference (GitHub Container Registry) ─────────────────────
OPTICORE_IMAGE=ghcr.io/dharshankumar8197/opticore-backend
OPTICORE_VERSION=latest

# ── Server Networking & Ports ─────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
API_PORT=8000

# ── YOLO26s AI Inference Model Configuration ──────────────────────────────────
# Default path inside container: /app/models/best.pt
# You can mount your own custom model in ./models/best.pt if desired.
MODEL_PATH=./models/best.pt
CONFIDENCE_THRESHOLD=0.50
IOU_THRESHOLD=0.45
IMAGE_SIZE=640

# Concurrency and Resource Limits (Optimized for 16GB Windows Hosts)
MAX_UPLOAD_SIZE_MB=15
MAX_CONCURRENT_INFERENCES=3

# ── Ngrok Public HTTPS Tunnel ──────────────────────────────────────────────────
# Get your free authtoken at: https://dashboard.ngrok.com/get-started/your-authtoken
# When enabled, start.bat will automatically establish a public HTTPS tunnel
# and display your live URL for camera access from Android, iPhone, iPad, and laptops.
#
# >> Example Reserved Ngrok Domain / URL:
#   NGROK_URL=https://escapade-feast-outdated.ngrok-free.dev
#
# >> Vercel Web App Connection:
# Set NEXT_PUBLIC_API_URL in your Vercel Project Settings to your active Ngrok URL:
#   NEXT_PUBLIC_API_URL=https://escapade-feast-outdated.ngrok-free.dev
NGROK_AUTHTOKEN=
NGROK_ENABLED=true



# ── Optional Contextual AI Guidance (Groq) ────────────────────────────────────
# Optional: Enter a Groq API key (https://console.groq.com) for real-time
# natural language scene explanations.
# Available models in your Groq account:
#   - openai/gpt-oss-120b (Recommended, highest accuracy & reasoning)
#   - openai/gpt-oss-20b (High-speed, low latency)
#   - qwen/qwen3.8-27b (Alibaba Cloud)
# If left empty, OptiCore uses its built-in local rule-based safety engine.
# Safety hazard alerts (potholes, cracks, stairs, vehicles) NEVER depend on Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Security & Access Controls ────────────────────────────────────────────────
# Set AUTH_REQUIRED=true to enforce JWT token authorization on API routes.
AUTH_REQUIRED=false
JWT_SECRET_KEY=change-this-jwt-secret-in-production-opticore
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
CORS_ALLOWED_ORIGINS=*
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/opticore.db
